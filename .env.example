# Backend env template. Copy to .env at the repo root for local dev.
NOCTURNE_ENV=dev
NOCTURNE_DATABASE_URL=postgresql+asyncpg://nocturne:nocturne@localhost:5432/nocturne
NOCTURNE_REDIS_URL=redis://localhost:6379/0
# live runs real tools in the Kali container; sim replays canned output and runs nothing.
NOCTURNE_RUN_MODE=live
NOCTURNE_ADMIN_USERNAME=admin
NOCTURNE_ADMIN_PASSWORD=admin
# Leave blank in dev: generated once and persisted to .nocturne-dev-secrets/.
# In production set real values here (or point *_FILE at mounted secret files).
NOCTURNE_JWT_SECRET=
NOCTURNE_SECRET_KEY=
NOCTURNE_S3_ENDPOINT=http://localhost:9000
NOCTURNE_S3_ACCESS_KEY=minioadmin
NOCTURNE_S3_SECRET_KEY=minioadmin
NOCTURNE_S3_REGION=us-east-1
NOCTURNE_S3_PRESIGN_ENDPOINT=
NOCTURNE_CORS_ORIGINS=http://localhost:5183

# --- Deploy (docker-compose.yml, via ./deploy.sh) ---
# Reverse-proxy site address. A domain (nocturne.example.com) gets automatic HTTPS;
# ":80" serves plain HTTP on the server IP. deploy.sh writes this for you.
SITE_ADDRESS=:80
# Which Caddy config to mount. "Caddyfile" for direct access (no domain or a
# domain pointed straight here). "Caddyfile.proxy" when a proxy or CDN
# (Cloudflare, Coolify, a load balancer) terminates TLS in front of this server.
CADDYFILE=Caddyfile
# Login cookie flag. Must be false over plain HTTP on an IP, true over HTTPS
# (including behind a proxy that serves HTTPS to the browser).
NOCTURNE_COOKIE_SECURE=false
# Host path of this checkout, so the in-app updater can run docker compose here.
# deploy.sh sets this for you; leave blank to disable the in-app Update button.
NOCTURNE_COMPOSE_DIR=
# Image used for the one-shot updater container (needs the docker compose plugin).
NOCTURNE_UPDATER_IMAGE=docker:cli
