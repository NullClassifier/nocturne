{
  "name": "nocturne",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter @nocturne/web dev",
    "build": "bun --filter @nocturne/web build",
    "preview": "bun --filter @nocturne/web preview",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "eslint .",
    "test": "bun --filter @nocturne/web test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript-eslint": "8.46.1"
  }
}
